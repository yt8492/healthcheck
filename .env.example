GOOGLE_CLOUD_PROJECT=your-google-cloud-project
# Google Cloud ConsoleでダウンロードしたOAuthクライアント設定のパス。
GOOGLE_OAUTH_CLIENT_FILE=.local/oauth-client.json
GOOGLE_HEALTH_TOKEN_FILE=.local/google-health-tokens.json
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
# Cloud RunではJSON形式の認証情報をSecret Managerから取得できます。
# GOOGLE_HEALTH_CREDENTIAL_SECRET=projects/your-google-cloud-project/secrets/google-health-oauth/versions/latest
# ローカルでFirestore Emulatorを使うときだけ指定します。
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
PORT=3001
HOST=127.0.0.1
